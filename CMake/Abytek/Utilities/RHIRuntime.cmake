
include(Abytek/Utilities/SetGlobal)
include(Abytek/Utilities/CommonFlags)

option(ABYTEK_ENGINE_RHI_ENABLE_DRIVER_DEBUGGER "Enable driver debugger for RHI" ON)
if(ABYTEK_AUTO_OPTIMIZATION_FLAGS AND ABYTEK_ENABLE_MAX_OPTIMIZATION)
    Abytek_SetGlobal(ABYTEK_ENGINE_RHI_ENABLE_DRIVER_DEBUGGER OFF)
else()
    Abytek_SetGlobal(ABYTEK_ENGINE_RHI_ENABLE_DRIVER_DEBUGGER ${ABYTEK_ENGINE_RHI_ENABLE_DRIVER_DEBUGGER})
endif()

option(ABYTEK_ENGINE_RHI_ENABLE_CAPTURE "Enable capture for RHI" ON)
if(ABYTEK_AUTO_OPTIMIZATION_FLAGS AND ABYTEK_ENABLE_MAX_OPTIMIZATION)
    Abytek_SetGlobal(ABYTEK_ENGINE_RHI_ENABLE_CAPTURE OFF) 
else()
    Abytek_SetGlobal(ABYTEK_ENGINE_RHI_ENABLE_CAPTURE ${ABYTEK_ENGINE_RHI_ENABLE_CAPTURE})
endif()

option(ABYTEK_ENGINE_RHI_ENABLE_DIRECTX12 "Enable DirectX 12 RHI API" ON)
option(ABYTEK_ENGINE_RHI_ENABLE_DIRECTX11 "Enable DirectX 11 RHI API" OFF)
option(ABYTEK_ENGINE_RHI_ENABLE_VULKAN "Enable Vulkan RHI API" OFF)
option(ABYTEK_ENGINE_RHI_ENABLE_OPENGL "Enable OpenGL RHI API" OFF)
option(ABYTEK_ENGINE_RHI_ENABLE_WEBGPU "Enable WebGPU RHI API" OFF)
option(ABYTEK_ENGINE_RHI_ENABLE_METAL "Enable Metal RHI API" OFF)

option(ABYTEK_ENGINE_RHI_ENABLE_DIRECTX12_AGILITY "Enable DirectX 12 Agility SDK" ON)
option(ABYTEK_ENGINE_RHI_ENABLE_PIX "Enable PIX" ON)
option(ABYTEK_ENGINE_RHI_ENABLE_NVTX "Enable NVTX" ON)

if(NOT WIN32)
    Abytek_SetGlobal(ABYTEK_ENGINE_RHI_ENABLE_DIRECTX12 OFF)
    Abytek_SetGlobal(ABYTEK_ENGINE_RHI_ENABLE_DIRECTX11 OFF)
endif()
if(NOT APPLE)
    Abytek_SetGlobal(ABYTEK_ENGINE_RHI_ENABLE_METAL OFF)
else()
    Abytek_SetGlobal(ABYTEK_ENGINE_RHI_ENABLE_VULKAN OFF)
    Abytek_SetGlobal(ABYTEK_ENGINE_RHI_ENABLE_OPENGL OFF)
endif()

if(NOT EMSCRIPTEN)
    Abytek_SetGlobal(ABYTEK_ENGINE_RHI_ENABLE_WEBGPU OFF)
else()
    Abytek_SetGlobal(ABYTEK_ENGINE_RHI_ENABLE_DIRECTX12 OFF)
    Abytek_SetGlobal(ABYTEK_ENGINE_RHI_ENABLE_DIRECTX11 OFF)
    Abytek_SetGlobal(ABYTEK_ENGINE_RHI_ENABLE_VULKAN OFF)
    Abytek_SetGlobal(ABYTEK_ENGINE_RHI_ENABLE_OPENGL OFF)
    Abytek_SetGlobal(ABYTEK_ENGINE_RHI_ENABLE_METAL OFF)
endif()

Abytek_SetGlobal(ABYTEK_ENGINE_RHI_ENABLE_DIRECTX OFF)
Abytek_SetGlobal(ABYTEK_ENGINE_RHI_ENABLE_DXGI OFF)
Abytek_SetGlobal(ABYTEK_ENGINE_RHI_ENABLE_DXC OFF)
Abytek_SetGlobal(ABYTEK_ENGINE_RHI_ENABLE_SPIRV OFF)

if(ABYTEK_ENGINE_RHI_ENABLE_DIRECTX12 OR ABYTEK_ENGINE_RHI_ENABLE_DIRECTX11)
    Abytek_SetGlobal(ABYTEK_ENGINE_RHI_ENABLE_DIRECTX ON)
    Abytek_SetGlobal(ABYTEK_ENGINE_RHI_ENABLE_DXGI ON)
    Abytek_SetGlobal(ABYTEK_ENGINE_RHI_ENABLE_DXC ON)
    Abytek_SetGlobal(ABYTEK_ENGINE_RHI_ENABLE_SPIRV ON)
else()
    Abytek_SetGlobal(ABYTEK_ENGINE_RHI_ENABLE_PIX OFF)
    Abytek_SetGlobal(ABYTEK_ENGINE_RHI_ENABLE_NVTX OFF)
endif()

if(NOT ABYTEK_ENGINE_RHI_ENABLE_DIRECTX12)
    Abytek_SetGlobal(ABYTEK_ENGINE_RHI_ENABLE_DIRECTX12_AGILITY OFF)
endif()

if(ABYTEK_ENGINE_RHI_ENABLE_DIRECTX12_AGILITY)
    Abytek_SetGlobal(ABYTEK_DIRECTX12_AGILITY_SDK_RUNTIME_RELATIVE_DIR "Abytek/Engine/RHI/DirectX12AgilitySDK")
endif()

if(NOT ABYTEK_ENGINE_RHI_ENABLE_CAPTURE)
    Abytek_SetGlobal(ABYTEK_ENGINE_RHI_ENABLE_PIX OFF)
    Abytek_SetGlobal(ABYTEK_ENGINE_RHI_ENABLE_NVTX OFF)
endif()

if(ABYTEK_ENGINE_RHI_ENABLE_PIX)
    Abytek_SetGlobal(ABYTEK_ENGINE_RHI_PIX_DIR "${ABYTEK_DEPENDENCIES_DIR}/Pix")
endif()