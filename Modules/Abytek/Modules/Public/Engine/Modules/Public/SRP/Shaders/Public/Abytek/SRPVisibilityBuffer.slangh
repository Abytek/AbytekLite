        }                                                                                                         \
    }

#define ABYTEK_SRP_LOAD_VISIBILITY_BUFFER_OPAQUE(Name, ...) ABYTEK_SRP_GET_VISIBILITY_BUFFER_OPAQUE_STRUCT(Name)::Load(__VA_ARGS__)
